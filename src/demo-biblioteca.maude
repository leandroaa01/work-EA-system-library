*** Testes do sistema de biblioteca. Execução: maude -no-banner demo-biblioteca.maude

load biblioteca.maude

fmod DEMO-BIBLIOTECA is
  protecting DIAGNOSTICO .

  ops ana bruno carla davi fantasma : -> IdUsuario .
  eq ana      = usuario(1) .
  eq bruno    = usuario(2) .
  eq carla    = usuario(3) .
  eq davi     = usuario(4) .
  *** fantasma nunca é registrado
  eq fantasma = usuario(99) .

  *** l7 nunca entra no acervo
  ops l1 l2 l3 l4 l5 l6 l7 : -> IdLivro .
  eq l1 = livro(1) .
  eq l2 = livro(2) .
  eq l3 = livro(3) .
  eq l4 = livro(4) .
  eq l5 = livro(5) .
  eq l6 = livro(6) .
  eq l7 = livro(7) .

  *** 4 usuários e 5 livros disponíveis
  op lib0 : -> Biblioteca .
  eq lib0 =
     addLivro(addLivro(addLivro(addLivro(addLivro(
       registrarUsuario(registrarUsuario(registrarUsuario(registrarUsuario(
         bibliotecaVazia, ana), bruno), carla), davi),
       l1, "Dom Casmurro"),
       l2, "Memorias Postumas"),
       l3, "Grande Sertao Veredas"),
       l4, "Vidas Secas"),
       l5, "Capitaes da Areia") .

  *** h1: entra o l6 (Cthulhu); h2 a h4: Ana pega l1, l2 e l4; h5: Bruno pega l3;
  *** h6: Bruno devolve l3; h7: Carla pega l3
  ops h1 h2 h3 h4 h5 h6 h7 lib1 : -> Biblioteca .
  eq h1 = addLivro(lib0, l6, "O chamado de Cthulhu") .
  eq h2 = emprestar(h1, l1, ana) .
  eq h3 = emprestar(h2, l2, ana) .
  eq h4 = emprestar(h3, l4, ana) .
  eq h5 = emprestar(h4, l3, bruno) .
  eq h6 = devolver(h5, l3, bruno) .
  eq h7 = emprestar(h6, l3, carla) .
  eq lib1 = h7 .

  op pequena : -> Biblioteca .
  eq pequena = biblioteca(item(l1, "Dom Casmurro", disponivel), ana) .

  *** estados inválidos montados à mão:
  *** ruim1 tem id repetido, ruim2 tem dono não registrado, ruim3 tem usuário repetido
  ops ruim1 ruim2 ruim3 : -> Biblioteca .
  eq ruim1 = biblioteca(item(l1, "A", disponivel) ; item(l1, "B", emprestado(ana)), ana) .
  eq ruim2 = biblioteca(item(l1, "A", emprestado(fantasma)), ana) .
  eq ruim3 = biblioteca(nilA, ana & ana) .
endfm

select DEMO-BIBLIOTECA .

*** A. Consultas básicas

*** [1] Total de livros do estado inicial [F10]
*** esperado: 5
reduce totalLivros(lib0) .

*** [2] Usuários registrados no estado inicial [F3]
*** esperado: 4
reduce totalUsuarios(lib0) .

*** [3] l1 pertence ao acervo? [F7]
*** esperado: true
reduce pertence?(lib0, l1) .

*** [4] l6 ainda não pertence a lib0 (elemento procurado não existe) [F7]
*** esperado: false
reduce pertence?(lib0, l6) .

*** [5] l1 está disponível em lib0? [F8]
*** esperado: true
reduce disponivel?(lib0, l1) .

*** [6] Nenhum empréstimo em lib0 [F11]
*** esperado: 0
reduce qtdEmprestados(lib0) .

*** [7] Disponíveis em lib0
*** esperado: 5
reduce qtdDisponiveis(lib0) .

*** [8] Total em lib1 (lib0 mais Cthulhu)
*** esperado: 6
reduce totalLivros(lib1) .

*** [9] Emprestados em lib1: l1 l2 l4 (Ana) e l3 (Carla) [F11]
*** esperado: 4
reduce qtdEmprestados(lib1) .

*** [10] Disponíveis em lib1: l5 e l6
*** esperado: 2
reduce qtdDisponiveis(lib1) .

*** [11] Ana possui l1? [F9]
*** esperado: true
reduce possui?(lib1, ana, l1) .

*** [12] Bruno devolveu l3, logo não possui [F9]
*** esperado: false
reduce possui?(lib1, bruno, l3) .

*** [13] Carla possui l3 [F9]
*** esperado: true
reduce possui?(lib1, carla, l3) .

*** [14] l1 está emprestado em lib1: não disponível
*** esperado: false
reduce disponivel?(lib1, l1) .

*** [15] l6 continua disponível em lib1
*** esperado: true
reduce disponivel?(lib1, l6) .

*** [16] Estrutura vazia (fronteira): total da biblioteca vazia
*** esperado: 0
reduce totalLivros(bibliotecaVazia) .

*** [17] Estrutura vazia: nada pertence
*** esperado: false
reduce pertence?(bibliotecaVazia, l1) .

*** B. Busca com erro explícito e livros de um usuário

*** [18] Busca de livro inexistente devolve a constante de erro
*** esperado: livroInexistente
reduce buscar(lib0, l7) .

*** [19] Busca de livro existente devolve o item
*** esperado: item(livro(6), "O chamado de Cthulhu", disponivel)
reduce buscar(lib1, l6) .

*** [20] Livros de Ana em lib1: VÁRIOS livros emprestados ao mesmo usuário
*** esperado: item(livro(1), "Dom Casmurro", emprestado(usuario(1))) ; item(livro(2), "Memorias Postumas", emprestado(usuario(1))) ; item(livro(4), "Vidas Secas", emprestado(usuario(1)))
reduce livrosDe(lib1, ana) .

*** [21] Quantidade de livros de Ana
*** esperado: 3
reduce qtdDe(lib1, ana) .

*** [22] Davi não tem livros: acervo vazio
*** esperado: nilA
reduce livrosDe(lib1, davi) .

*** C. Exemplo-guia: totalLivros(addLivro(B, x)) = totalLivros(B) + 1  [P1]

*** [23] O valor: 5 + 1
*** esperado: 6
reduce totalLivros(addLivro(lib0, l6, "O chamado de Cthulhu")) .

*** [24] A propriedade para B = lib0
*** esperado: true
reduce totalLivros(addLivro(lib0, l6, "O chamado de Cthulhu")) == totalLivros(lib0) + 1 .

*** [25] A propriedade para B = vazia (caso de fronteira)
*** esperado: true
reduce totalLivros(addLivro(bibliotecaVazia, l6, "O chamado de Cthulhu")) == totalLivros(bibliotecaVazia) + 1 .

*** [26] A propriedade para B = lib1 (com empréstimos)
*** esperado: true
reduce totalLivros(addLivro(lib1, l7, "Novo titulo")) == totalLivros(lib1) + 1 .

*** D. Operações compostas e regra R3

*** [27] emprestar -> devolver -> removerLivro de l5: total cai para 4 [R3, R5]
*** esperado: 4
reduce totalLivros(removerLivro(devolver(emprestar(lib0, l5, davi), l5, davi), l5)) .

*** [28] ... e l5 não pertence mais ao acervo
*** esperado: false
reduce pertence?(removerLivro(devolver(emprestar(lib0, l5, davi), l5, davi), l5), l5) .

*** [29] R3, antes: após emprestar l1, ele não está disponível
*** esperado: false
reduce disponivel?(emprestar(lib0, l1, ana), l1) .

*** [30] R3, depois: após devolver, l1 volta a estar disponível [P2]
*** esperado: true
reduce disponivel?(devolver(emprestar(lib0, l1, ana), l1, ana), l1) .

*** [31] P2 forte: devolver desfaz emprestar (restaura o estado inteiro)
*** esperado: true
reduce devolver(emprestar(lib0, l1, ana), l1, ana) == lib0 .

*** [32] Remoção de livro disponível: total diminui em 1 [F2]
*** esperado: true
reduce totalLivros(removerLivro(lib0, l1)) + 1 == totalLivros(lib0) .

*** [33] Remover o ÚNICO livro do acervo (fronteira): volta ao estado sem livros
*** esperado: true
reduce removerLivro(pequena, l1) == biblioteca(nilA, ana) .

*** [34] Remover o primeiro, o do meio e o último de lib0
*** esperado: true
reduce (totalLivros(removerLivro(lib0, l1)) == 4) and (totalLivros(removerLivro(lib0, l3)) == 4) and (totalLivros(removerLivro(lib0, l5)) == 4) .

*** [35] Registrar usuário novo e remover usuário sem livros [F3, F4]
*** esperado: true
reduce (totalUsuarios(registrarUsuario(lib0, usuario(5))) == 5) and (removerUsuario(registrarUsuario(lib0, usuario(5)), usuario(5)) == lib0) .

*** E. Situações INVÁLIDAS: o estado NÃO muda

*** [36] I1, R1: emprestar livro inexistente
*** esperado: true
reduce emprestar(lib0, l7, ana) == lib0 .

*** [37] I2, R2: emprestar livro já emprestado (a outro usuário)
*** esperado: true
reduce emprestar(lib1, l1, bruno) == lib1 .

*** [38] I2, R2: emprestar de novo ao mesmo usuário que já o tem
*** esperado: true
reduce emprestar(lib1, l1, ana) == lib1 .

*** [39] I3, R4: devolver livro que não está emprestado
*** esperado: true
reduce devolver(lib0, l1, ana) == lib0 .

*** [40] I4, R4: devolver livro emprestado a OUTRO usuário
*** esperado: true
reduce devolver(lib1, l1, bruno) == lib1 .

*** [41] I5, R5: remover livro emprestado
*** esperado: true
reduce removerLivro(lib1, l1) == lib1 .

*** [42] I5b, R5: remover livro inexistente
*** esperado: true
reduce removerLivro(lib0, l7) == lib0 .

*** [43] I6, R6: adicionar livro com id repetido (mesmo com outro título)
*** esperado: true
reduce addLivro(lib0, l1, "Outro titulo") == lib0 .

*** [44] I6, R6: o total de livros não muda
*** esperado: 5
reduce totalLivros(addLivro(lib0, l1, "Outro titulo")) .

*** [45] I7, E1: registrar usuário duplicado
*** esperado: true
reduce registrarUsuario(lib0, ana) == lib0 .

*** [46] I8, E3: emprestar a usuário não registrado
*** esperado: true
reduce emprestar(lib0, l1, fantasma) == lib0 .

*** [47] I9, E2: remover usuário com livros emprestados
*** esperado: true
reduce removerUsuario(lib1, ana) == lib1 .

*** [48] I9b, E2: remover usuário inexistente
*** esperado: true
reduce removerUsuario(lib0, fantasma) == lib0 .

*** [49] I10, E4: Ana já tem 3 livros (limite): quarto empréstimo é recusado
*** esperado: true
reduce emprestar(lib1, l5, ana) == lib1 .

*** [50] Fronteira: emprestar em biblioteca vazia
*** esperado: true
reduce emprestar(bibliotecaVazia, l1, ana) == bibliotecaVazia .

*** [51] P3: operação inválida e válida diferem no efeito: Bruno pode pegar l5
*** esperado: 5
reduce qtdEmprestados(emprestar(lib1, l5, bruno)) .

*** F. Guardas e diagnóstico com erro explícito

*** [52] Guarda do empréstimo bloqueado pelo limite
*** esperado: false
reduce podeEmprestar?(lib1, l5, ana) .

*** [53] Guarda do empréstimo permitido
*** esperado: true
reduce podeEmprestar?(lib1, l5, bruno) .

*** [54] Diagnóstico R1
*** esperado: errLivroInexistente
reduce diagEmprestar(lib0, l7, ana) .

*** [55] Diagnóstico R2
*** esperado: errLivroJaEmprestado
reduce diagEmprestar(lib1, l1, bruno) .

*** [56] Diagnóstico E3
*** esperado: errUsuarioInexistente
reduce diagEmprestar(lib0, l1, fantasma) .

*** [57] Diagnóstico E4
*** esperado: errLimiteExcedido
reduce diagEmprestar(lib1, l5, ana) .

*** [58] Diagnóstico de empréstimo válido
*** esperado: ok
reduce diagEmprestar(lib1, l5, bruno) .

*** [59] Diagnóstico R4 (livro de outro usuário)
*** esperado: errNaoEmprestadoAoUsuario
reduce diagDevolver(lib1, l1, bruno) .

*** [60] Diagnóstico R5
*** esperado: errLivroEmprestado
reduce diagRemoverLivro(lib1, l1) .

*** [61] Diagnóstico R6
*** esperado: errIdRepetido
reduce diagAddLivro(lib0, l1) .

*** [62] Diagnóstico E1
*** esperado: errUsuarioRepetido
reduce diagRegistrar(lib0, ana) .

*** [63] Diagnóstico E2
*** esperado: errUsuarioComLivros
reduce diagRemoverUsuario(lib1, ana) .

*** [64] Guarda e diagnóstico concordam: podeDevolver? <=> diagDevolver == ok
*** esperado: true
reduce (podeDevolver?(lib1, l1, ana) == (diagDevolver(lib1, l1, ana) == ok)) and (podeDevolver?(lib1, l1, bruno) == (diagDevolver(lib1, l1, bruno) == ok)) .

*** G. R7 e invariantes

*** [65] R7 em lib0: #disp + #emp == #total
*** esperado: true
reduce qtdDisponiveis(lib0) + qtdEmprestados(lib0) == totalLivros(lib0) .

*** [66] R7 em lib1
*** esperado: true
reduce qtdDisponiveis(lib1) + qtdEmprestados(lib1) == totalLivros(lib1) .

*** [67] R7 nos estados intermediários h1..h7 da história
*** esperado: true
reduce contagemOk?(h1) and contagemOk?(h2) and contagemOk?(h3) and contagemOk?(h4) and contagemOk?(h5) and contagemOk?(h6) and contagemOk?(h7) .

*** [68] R7 após operações inválidas e após remoções [P4]
*** esperado: true
reduce contagemOk?(emprestar(lib1, l1, bruno)) and contagemOk?(removerLivro(lib1, l1)) and contagemOk?(removerLivro(lib0, l3)) and contagemOk?(devolver(lib1, l1, ana)) and contagemOk?(addLivro(lib1, l1, "x")) .

*** [69] invariante? em estados da história [P4]
*** esperado: true
reduce invariante?(lib0) and invariante?(h1) and invariante?(h2) and invariante?(h4) and invariante?(h6) and invariante?(lib1) .

*** [70] invariante? preservado por operações válidas e inválidas [P4, P5]
*** esperado: true
reduce invariante?(addLivro(lib1, l7, "Novo")) and idsUnicos?(addLivro(lib1, l7, "Novo")) and idsUnicos?(addLivro(lib1, l1, "Repetido")) and invariante?(removerUsuario(lib1, davi)) and invariante?(emprestar(lib1, l5, ana)) .

*** [71] Estado montado à mão com ids repetidos: idsUnicos? = false [R6]
*** esperado: false
reduce idsUnicos?(ruim1) .

*** [72] ... logo o invariante falha
*** esperado: false
reduce invariante?(ruim1) .

*** [73] Livro emprestado a usuário não registrado: donosRegistrados? = false
*** esperado: false
reduce donosRegistrados?(ruim2) .

*** [74] Usuário duplicado: usuariosUnicos? = false [E1]
*** esperado: false
reduce usuariosUnicos?(ruim3) .

*** [75] Mesmo nos estados inválidos, a contagem R7 vale (Status só tem 2 construtores)
*** esperado: true
reduce contagemOk?(ruim1) and contagemOk?(ruim2) .

*** Conferência automática: cada tN repete o teste [N] comparando com o valor esperado.
*** Se algum der false, reduza só aquele (ex.: reduce t17 .) para achar o problema.

fmod CONFERENCIA is
  protecting DEMO-BIBLIOTECA .

  ops t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 t16 t17 t18 t19 t20 t21 t22 t23 t24 t25 t26 t27 t28 t29 t30 t31 t32 t33 t34 t35 t36 t37 t38 t39 t40 t41 t42 t43 t44 t45 t46 t47 t48 t49 t50 t51 t52 t53 t54 t55 t56 t57 t58 t59 t60 t61 t62 t63 t64 t65 t66 t67 t68 t69 t70 t71 t72 t73 t74 t75 : -> Bool .

  eq t1 = totalLivros(lib0) == 5 .
  eq t2 = totalUsuarios(lib0) == 4 .
  eq t3 = pertence?(lib0, l1) .
  eq t4 = pertence?(lib0, l6) == false .
  eq t5 = disponivel?(lib0, l1) .
  eq t6 = qtdEmprestados(lib0) == 0 .
  eq t7 = qtdDisponiveis(lib0) == 5 .
  eq t8 = totalLivros(lib1) == 6 .
  eq t9 = qtdEmprestados(lib1) == 4 .
  eq t10 = qtdDisponiveis(lib1) == 2 .
  eq t11 = possui?(lib1, ana, l1) .
  eq t12 = possui?(lib1, bruno, l3) == false .
  eq t13 = possui?(lib1, carla, l3) .
  eq t14 = disponivel?(lib1, l1) == false .
  eq t15 = disponivel?(lib1, l6) .
  eq t16 = totalLivros(bibliotecaVazia) == 0 .
  eq t17 = pertence?(bibliotecaVazia, l1) == false .
  eq t18 = buscar(lib0, l7) == livroInexistente .
  eq t19 = buscar(lib1, l6) == item(livro(6), "O chamado de Cthulhu", disponivel) .
  eq t20 = livrosDe(lib1, ana) == (item(livro(1), "Dom Casmurro", emprestado(usuario(1))) ; item(livro(2), "Memorias Postumas", emprestado(usuario(1))) ; item(livro(4), "Vidas Secas", emprestado(usuario(1)))) .
  eq t21 = qtdDe(lib1, ana) == 3 .
  eq t22 = livrosDe(lib1, davi) == nilA .
  eq t23 = (totalLivros(addLivro(lib0, l6, "O chamado de Cthulhu"))) == 6 .
  eq t24 = totalLivros(addLivro(lib0, l6, "O chamado de Cthulhu")) == totalLivros(lib0) + 1 .
  eq t25 = totalLivros(addLivro(bibliotecaVazia, l6, "O chamado de Cthulhu")) == totalLivros(bibliotecaVazia) + 1 .
  eq t26 = totalLivros(addLivro(lib1, l7, "Novo titulo")) == totalLivros(lib1) + 1 .
  eq t27 = (totalLivros(removerLivro(devolver(emprestar(lib0, l5, davi), l5, davi), l5))) == 4 .
  eq t28 = (pertence?(removerLivro(devolver(emprestar(lib0, l5, davi), l5, davi), l5), l5)) == false .
  eq t29 = (disponivel?(emprestar(lib0, l1, ana), l1)) == false .
  eq t30 = disponivel?(devolver(emprestar(lib0, l1, ana), l1, ana), l1) .
  eq t31 = devolver(emprestar(lib0, l1, ana), l1, ana) == lib0 .
  eq t32 = totalLivros(removerLivro(lib0, l1)) + 1 == totalLivros(lib0) .
  eq t33 = removerLivro(pequena, l1) == biblioteca(nilA, ana) .
  eq t34 = (totalLivros(removerLivro(lib0, l1)) == 4) and (totalLivros(removerLivro(lib0, l3)) == 4) and (totalLivros(removerLivro(lib0, l5)) == 4) .
  eq t35 = (totalUsuarios(registrarUsuario(lib0, usuario(5))) == 5) and (removerUsuario(registrarUsuario(lib0, usuario(5)), usuario(5)) == lib0) .
  eq t36 = emprestar(lib0, l7, ana) == lib0 .
  eq t37 = emprestar(lib1, l1, bruno) == lib1 .
  eq t38 = emprestar(lib1, l1, ana) == lib1 .
  eq t39 = devolver(lib0, l1, ana) == lib0 .
  eq t40 = devolver(lib1, l1, bruno) == lib1 .
  eq t41 = removerLivro(lib1, l1) == lib1 .
  eq t42 = removerLivro(lib0, l7) == lib0 .
  eq t43 = addLivro(lib0, l1, "Outro titulo") == lib0 .
  eq t44 = (totalLivros(addLivro(lib0, l1, "Outro titulo"))) == 5 .
  eq t45 = registrarUsuario(lib0, ana) == lib0 .
  eq t46 = emprestar(lib0, l1, fantasma) == lib0 .
  eq t47 = removerUsuario(lib1, ana) == lib1 .
  eq t48 = removerUsuario(lib0, fantasma) == lib0 .
  eq t49 = emprestar(lib1, l5, ana) == lib1 .
  eq t50 = emprestar(bibliotecaVazia, l1, ana) == bibliotecaVazia .
  eq t51 = (qtdEmprestados(emprestar(lib1, l5, bruno))) == 5 .
  eq t52 = podeEmprestar?(lib1, l5, ana) == false .
  eq t53 = podeEmprestar?(lib1, l5, bruno) .
  eq t54 = diagEmprestar(lib0, l7, ana) == errLivroInexistente .
  eq t55 = diagEmprestar(lib1, l1, bruno) == errLivroJaEmprestado .
  eq t56 = diagEmprestar(lib0, l1, fantasma) == errUsuarioInexistente .
  eq t57 = diagEmprestar(lib1, l5, ana) == errLimiteExcedido .
  eq t58 = diagEmprestar(lib1, l5, bruno) == ok .
  eq t59 = diagDevolver(lib1, l1, bruno) == errNaoEmprestadoAoUsuario .
  eq t60 = diagRemoverLivro(lib1, l1) == errLivroEmprestado .
  eq t61 = diagAddLivro(lib0, l1) == errIdRepetido .
  eq t62 = diagRegistrar(lib0, ana) == errUsuarioRepetido .
  eq t63 = diagRemoverUsuario(lib1, ana) == errUsuarioComLivros .
  eq t64 = (podeDevolver?(lib1, l1, ana) == (diagDevolver(lib1, l1, ana) == ok)) and (podeDevolver?(lib1, l1, bruno) == (diagDevolver(lib1, l1, bruno) == ok)) .
  eq t65 = qtdDisponiveis(lib0) + qtdEmprestados(lib0) == totalLivros(lib0) .
  eq t66 = qtdDisponiveis(lib1) + qtdEmprestados(lib1) == totalLivros(lib1) .
  eq t67 = contagemOk?(h1) and contagemOk?(h2) and contagemOk?(h3) and contagemOk?(h4) and contagemOk?(h5) and contagemOk?(h6) and contagemOk?(h7) .
  eq t68 = contagemOk?(emprestar(lib1, l1, bruno)) and contagemOk?(removerLivro(lib1, l1)) and contagemOk?(removerLivro(lib0, l3)) and contagemOk?(devolver(lib1, l1, ana)) and contagemOk?(addLivro(lib1, l1, "x")) .
  eq t69 = invariante?(lib0) and invariante?(h1) and invariante?(h2) and invariante?(h4) and invariante?(h6) and invariante?(lib1) .
  eq t70 = invariante?(addLivro(lib1, l7, "Novo")) and idsUnicos?(addLivro(lib1, l7, "Novo")) and idsUnicos?(addLivro(lib1, l1, "Repetido")) and invariante?(removerUsuario(lib1, davi)) and invariante?(emprestar(lib1, l5, ana)) .
  eq t71 = idsUnicos?(ruim1) == false .
  eq t72 = invariante?(ruim1) == false .
  eq t73 = donosRegistrados?(ruim2) == false .
  eq t74 = usuariosUnicos?(ruim3) == false .
  eq t75 = contagemOk?(ruim1) and contagemOk?(ruim2) .

  ops secaoA? secaoC? secaoD? secaoE? secaoF? secaoG? todos? : -> Bool .
  eq secaoA? = t1 and t2 and t3 and t4 and t5 and t6 and t7 and t8 and t9 and t10 and t11 and t12 and t13 and t14 and t15 and t16 and t17 and t18 and t19 and t20 and t21 and t22 .
  eq secaoC? = t23 and t24 and t25 and t26 .
  eq secaoD? = t27 and t28 and t29 and t30 and t31 and t32 and t33 and t34 and t35 .
  eq secaoE? = t36 and t37 and t38 and t39 and t40 and t41 and t42 and t43 and t44 and t45 and t46 and t47 and t48 and t49 and t50 .
  eq secaoF? = t51 and t52 and t53 and t54 and t55 and t56 and t57 and t58 and t59 and t60 and t61 and t62 and t63 and t64 .
  eq secaoG? = t65 and t66 and t67 and t68 and t69 and t70 and t71 and t72 and t73 and t74 and t75 .
  eq todos? = secaoA? and secaoC? and secaoD? and secaoE? and secaoF? and secaoG? .
endfm

