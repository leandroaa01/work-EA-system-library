*** Sistema de Biblioteca - especificação algébrica em Maude
*** Regras extras: E1 usuário não duplicado, E2 não remover usuário com livros,
*** E3 emprestar só a usuário registrado, E4 limite de empréstimos.

fmod LIVRO-USUARIO is
  protecting NAT .
  protecting STRING .

  sorts IdLivro IdUsuario Status Item .

  op livro : Nat -> IdLivro [ctor] .
  op usuario : Nat -> IdUsuario [ctor] .
  op disponivel : -> Status [ctor] .
  op emprestado : IdUsuario -> Status [ctor] .
  op item : IdLivro String Status -> Item [ctor] .

  op getId : Item -> IdLivro .
  op comStatus : Item Status -> Item .
  op itemDisponivel? : Item -> Bool .
  op itemDe? : Item IdUsuario -> Bool .

  var L : IdLivro .
  vars U U1 : IdUsuario .
  var T : String .
  vars S S1 : Status .

  eq getId(item(L, T, S)) = L .
  eq comStatus(item(L, T, S), S1) = item(L, T, S1) .

  eq itemDisponivel?(item(L, T, disponivel)) = true .
  eq itemDisponivel?(item(L, T, emprestado(U))) = false .

  eq itemDe?(item(L, T, disponivel), U) = false .
  eq itemDe?(item(L, T, emprestado(U1)), U) = (U1 == U) .
endfm

fmod ACERVO is
  protecting LIVRO-USUARIO .

  sorts Acervo ItemOuErro .
  subsort Item < Acervo .
  subsort Item < ItemOuErro .

  *** monóide: _;_ é associativa com identidade nilA
  op nilA : -> Acervo [ctor] .
  op _;_ : Acervo Acervo -> Acervo [ctor assoc id: nilA] .
  op livroInexistente : -> ItemOuErro [ctor] .

  op totalA : Acervo -> Nat .
  op qtdDisponiveisA : Acervo -> Nat .
  op qtdEmprestadosA : Acervo -> Nat .
  op existeA? : Acervo IdLivro -> Bool .
  op disponivelA? : Acervo IdLivro -> Bool .
  op possuiA? : Acervo IdUsuario IdLivro -> Bool .
  op buscarA : Acervo IdLivro -> ItemOuErro .
  op livrosDeA : Acervo IdUsuario -> Acervo .
  op idsUnicosA? : Acervo -> Bool .
  op removerA : Acervo IdLivro -> Acervo .
  op definirStatus : Acervo IdLivro Status -> Acervo .

  var A : Acervo .
  var I : Item .
  var L : IdLivro .
  var U : IdUsuario .
  var T : String .
  var S : Status .

  eq totalA(nilA) = 0 .
  eq totalA(I ; A) = 1 + totalA(A) .

  *** R7
  eq qtdDisponiveisA(nilA) = 0 .
  eq qtdDisponiveisA(item(L, T, disponivel) ; A) = 1 + qtdDisponiveisA(A) .
  eq qtdDisponiveisA(item(L, T, emprestado(U)) ; A) = qtdDisponiveisA(A) .

  eq qtdEmprestadosA(nilA) = 0 .
  eq qtdEmprestadosA(item(L, T, disponivel) ; A) = qtdEmprestadosA(A) .
  eq qtdEmprestadosA(item(L, T, emprestado(U)) ; A) = 1 + qtdEmprestadosA(A) .

  eq existeA?(nilA, L) = false .
  eq existeA?(I ; A, L) = (getId(I) == L) or existeA?(A, L) .

  eq disponivelA?(nilA, L) = false .
  eq disponivelA?(I ; A, L) =
    if getId(I) == L then itemDisponivel?(I) else disponivelA?(A, L) fi .

  eq possuiA?(nilA, U, L) = false .
  eq possuiA?(I ; A, U, L) =
    if getId(I) == L then itemDe?(I, U) else possuiA?(A, U, L) fi .

  eq buscarA(nilA, L) = livroInexistente .
  eq buscarA(I ; A, L) = if getId(I) == L then I else buscarA(A, L) fi .

  eq livrosDeA(nilA, U) = nilA .
  eq livrosDeA(I ; A, U) =
    if itemDe?(I, U) then I ; livrosDeA(A, U) else livrosDeA(A, U) fi .

  *** R6
  eq idsUnicosA?(nilA) = true .
  eq idsUnicosA?(I ; A) = not existeA?(A, getId(I)) and idsUnicosA?(A) .

  eq removerA(nilA, L) = nilA .
  eq removerA(I ; A, L) = if getId(I) == L then A else I ; removerA(A, L) fi .

  eq definirStatus(nilA, L, S) = nilA .
  eq definirStatus(I ; A, L, S) =
    if getId(I) == L then comStatus(I, S) ; A
    else I ; definirStatus(A, L, S) fi .
endfm

fmod USUARIOS is
  protecting LIVRO-USUARIO .

  sort Usuarios .
  subsort IdUsuario < Usuarios .

  op nilU : -> Usuarios [ctor] .
  op _&_ : Usuarios Usuarios -> Usuarios [ctor assoc id: nilU] .

  op totalU : Usuarios -> Nat .
  op existeU? : Usuarios IdUsuario -> Bool .
  op removerU : Usuarios IdUsuario -> Usuarios .
  op unicosU? : Usuarios -> Bool .

  vars U U1 : IdUsuario .
  var Us : Usuarios .

  eq totalU(nilU) = 0 .
  eq totalU(U & Us) = 1 + totalU(Us) .

  eq existeU?(nilU, U1) = false .
  eq existeU?(U & Us, U1) = (U == U1) or existeU?(Us, U1) .

  eq removerU(nilU, U1) = nilU .
  eq removerU(U & Us, U1) = if U == U1 then Us else U & removerU(Us, U1) fi .

  eq unicosU?(nilU) = true .
  eq unicosU?(U & Us) = not existeU?(Us, U) and unicosU?(Us) .
endfm

fmod BIBLIOTECA is
  protecting ACERVO .
  protecting USUARIOS .

  sort Biblioteca .

  op biblioteca : Acervo Usuarios -> Biblioteca [ctor] .
  op bibliotecaVazia : -> Biblioteca .
  op limiteEmprestimos : -> Nat .

  *** consultas
  op totalLivros : Biblioteca -> Nat .
  op qtdEmprestados : Biblioteca -> Nat .
  op qtdDisponiveis : Biblioteca -> Nat .
  op totalUsuarios : Biblioteca -> Nat .
  op pertence? : Biblioteca IdLivro -> Bool .
  op disponivel? : Biblioteca IdLivro -> Bool .
  op possui? : Biblioteca IdUsuario IdLivro -> Bool .
  op existeUsuario? : Biblioteca IdUsuario -> Bool .
  op buscar : Biblioteca IdLivro -> ItemOuErro .
  op livrosDe : Biblioteca IdUsuario -> Acervo .
  op qtdDe : Biblioteca IdUsuario -> Nat .

  *** guardas
  op podeAddLivro? : Biblioteca IdLivro -> Bool .
  op podeRemoverLivro? : Biblioteca IdLivro -> Bool .
  op podeRegistrar? : Biblioteca IdUsuario -> Bool .
  op podeRemoverUsuario? : Biblioteca IdUsuario -> Bool .
  op podeEmprestar? : Biblioteca IdLivro IdUsuario -> Bool .
  op podeDevolver? : Biblioteca IdLivro IdUsuario -> Bool .

  *** operações
  op addLivro : Biblioteca IdLivro String -> Biblioteca .
  op removerLivro : Biblioteca IdLivro -> Biblioteca .
  op registrarUsuario : Biblioteca IdUsuario -> Biblioteca .
  op removerUsuario : Biblioteca IdUsuario -> Biblioteca .
  op emprestar : Biblioteca IdLivro IdUsuario -> Biblioteca .
  op devolver : Biblioteca IdLivro IdUsuario -> Biblioteca .

  *** invariantes
  op idsUnicos? : Biblioteca -> Bool .
  op contagemOk? : Biblioteca -> Bool .
  op usuariosUnicos? : Biblioteca -> Bool .
  op donosRegistrados? : Biblioteca -> Bool .
  op invariante? : Biblioteca -> Bool .
  op donosRegA? : Acervo Usuarios -> Bool .

  var A : Acervo .
  var Us : Usuarios .
  var L : IdLivro .
  var U : IdUsuario .
  var T : String .
  var B : Biblioteca .

  eq bibliotecaVazia = biblioteca(nilA, nilU) .
  eq limiteEmprestimos = 3 .

  eq totalLivros(biblioteca(A, Us)) = totalA(A) .
  eq qtdEmprestados(biblioteca(A, Us)) = qtdEmprestadosA(A) .
  eq qtdDisponiveis(biblioteca(A, Us)) = qtdDisponiveisA(A) .
  eq totalUsuarios(biblioteca(A, Us)) = totalU(Us) .

  eq pertence?(biblioteca(A, Us), L) = existeA?(A, L) .
  eq disponivel?(biblioteca(A, Us), L) = disponivelA?(A, L) .
  eq possui?(biblioteca(A, Us), U, L) = possuiA?(A, U, L) .
  eq existeUsuario?(biblioteca(A, Us), U) = existeU?(Us, U) .
  eq buscar(biblioteca(A, Us), L) = buscarA(A, L) .
  eq livrosDe(biblioteca(A, Us), U) = livrosDeA(A, U) .
  eq qtdDe(biblioteca(A, Us), U) = totalA(livrosDeA(A, U)) .

  *** R6
  eq podeAddLivro?(B, L) = not pertence?(B, L) .
  *** R5
  eq podeRemoverLivro?(B, L) = pertence?(B, L) and disponivel?(B, L) .
  *** E1
  eq podeRegistrar?(B, U) = not existeUsuario?(B, U) .
  *** E2
  eq podeRemoverUsuario?(B, U) = existeUsuario?(B, U) and (qtdDe(B, U) == 0) .
  *** R1, R2, E3, E4
  eq podeEmprestar?(B, L, U) =
    existeUsuario?(B, U) and pertence?(B, L) and disponivel?(B, L)
    and (qtdDe(B, U) < limiteEmprestimos) .
  *** R4
  eq podeDevolver?(B, L, U) = possui?(B, U, L) .

  eq addLivro(biblioteca(A, Us), L, T) =
    if podeAddLivro?(biblioteca(A, Us), L)
    then biblioteca(A ; item(L, T, disponivel), Us)
    else biblioteca(A, Us) fi .

  eq removerLivro(biblioteca(A, Us), L) =
    if podeRemoverLivro?(biblioteca(A, Us), L)
    then biblioteca(removerA(A, L), Us)
    else biblioteca(A, Us) fi .

  eq registrarUsuario(biblioteca(A, Us), U) =
    if podeRegistrar?(biblioteca(A, Us), U)
    then biblioteca(A, Us & U)
    else biblioteca(A, Us) fi .

  eq removerUsuario(biblioteca(A, Us), U) =
    if podeRemoverUsuario?(biblioteca(A, Us), U)
    then biblioteca(A, removerU(Us, U))
    else biblioteca(A, Us) fi .

  eq emprestar(biblioteca(A, Us), L, U) =
    if podeEmprestar?(biblioteca(A, Us), L, U)
    then biblioteca(definirStatus(A, L, emprestado(U)), Us)
    else biblioteca(A, Us) fi .

  *** R3
  eq devolver(biblioteca(A, Us), L, U) =
    if podeDevolver?(biblioteca(A, Us), L, U)
    then biblioteca(definirStatus(A, L, disponivel), Us)
    else biblioteca(A, Us) fi .

  eq idsUnicos?(biblioteca(A, Us)) = idsUnicosA?(A) .
  eq usuariosUnicos?(biblioteca(A, Us)) = unicosU?(Us) .
  *** R7
  eq contagemOk?(B) = (qtdDisponiveis(B) + qtdEmprestados(B)) == totalLivros(B) .
  eq donosRegistrados?(biblioteca(A, Us)) = donosRegA?(A, Us) .

  eq donosRegA?(nilA, Us) = true .
  eq donosRegA?(item(L, T, disponivel) ; A, Us) = donosRegA?(A, Us) .
  eq donosRegA?(item(L, T, emprestado(U)) ; A, Us) =
    existeU?(Us, U) and donosRegA?(A, Us) .

  eq invariante?(B) =
    idsUnicos?(B) and contagemOk?(B) and usuariosUnicos?(B) and donosRegistrados?(B) .
endfm

*** versões das operações que dizem qual erro ocorreu
fmod DIAGNOSTICO is
  protecting BIBLIOTECA .

  sort Diagnostico .

  op ok : -> Diagnostico [ctor] .
  op errLivroInexistente : -> Diagnostico [ctor] .
  op errLivroJaEmprestado : -> Diagnostico [ctor] .
  op errNaoEmprestadoAoUsuario : -> Diagnostico [ctor] .
  op errLivroEmprestado : -> Diagnostico [ctor] .
  op errIdRepetido : -> Diagnostico [ctor] .
  op errUsuarioRepetido : -> Diagnostico [ctor] .
  op errUsuarioInexistente : -> Diagnostico [ctor] .
  op errUsuarioComLivros : -> Diagnostico [ctor] .
  op errLimiteExcedido : -> Diagnostico [ctor] .

  op diagAddLivro : Biblioteca IdLivro -> Diagnostico .
  op diagRemoverLivro : Biblioteca IdLivro -> Diagnostico .
  op diagRegistrar : Biblioteca IdUsuario -> Diagnostico .
  op diagRemoverUsuario : Biblioteca IdUsuario -> Diagnostico .
  op diagEmprestar : Biblioteca IdLivro IdUsuario -> Diagnostico .
  op diagDevolver : Biblioteca IdLivro IdUsuario -> Diagnostico .

  var B : Biblioteca .
  var L : IdLivro .
  var U : IdUsuario .

  eq diagAddLivro(B, L) = if pertence?(B, L) then errIdRepetido else ok fi .

  eq diagRemoverLivro(B, L) =
    if not pertence?(B, L) then errLivroInexistente
    else if not disponivel?(B, L) then errLivroEmprestado else ok fi fi .

  eq diagRegistrar(B, U) = if existeUsuario?(B, U) then errUsuarioRepetido else ok fi .

  eq diagRemoverUsuario(B, U) =
    if not existeUsuario?(B, U) then errUsuarioInexistente
    else if qtdDe(B, U) =/= 0 then errUsuarioComLivros else ok fi fi .

  eq diagEmprestar(B, L, U) =
    if not existeUsuario?(B, U) then errUsuarioInexistente
    else if not pertence?(B, L) then errLivroInexistente
    else if not disponivel?(B, L) then errLivroJaEmprestado
    else if qtdDe(B, U) >= limiteEmprestimos then errLimiteExcedido
    else ok fi fi fi fi .

  eq diagDevolver(B, L, U) =
    if not pertence?(B, L) then errLivroInexistente
    else if not possui?(B, U, L) then errNaoEmprestadoAoUsuario
    else ok fi fi .
endfm
